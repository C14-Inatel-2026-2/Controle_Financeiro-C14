// Validação de pull requests para a main, usada pelo job pr-validacao.
//
// O job (infra/jenkins/jobs.groovy) consulta o GitHub a cada poucos minutos e,
// para cada PR aberto a partir deste repositório, obtém o commit do PR e o
// mescla com a ponta atual da main só no workspace do agente. Nada é enviado ao
// GitHub além do status do commit. Conflito com a main faz a etapa de mescla
// falhar e reprova o PR.
//
// As etapas repetem os comandos dos jobs da pipeline completa (frontend-build,
// backend-build, backend-unit-igor e backend-integration-coverage), sem a
// cobertura e sem construir ou publicar a imagem.
pipeline {
    agent { label 'node24' }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Obter código') {
            steps {
                deleteDir()

                // Commit atual do PR.
                checkout scm

                // Mescla local com a branch de destino (CHANGE_TARGET, a main). O GitHub
                // não gera a ref de mescla de PRs com conflito, por isso ela é feita aqui.
                sh '''
                    git fetch --no-tags origin "+refs/heads/${CHANGE_TARGET}:refs/remotes/origin/${CHANGE_TARGET}"
                    if ! git -c user.name=Jenkins -c user.email=jenkins@localhost merge --no-ff --no-edit "origin/${CHANGE_TARGET}"; then
                        git merge --abort || true
                        echo "O PR tem conflito com a ${CHANGE_TARGET}. Atualize a branch do PR e resolva o conflito."
                        exit 1
                    fi

                    # Registra no console exatamente o que foi testado.
                    git log -1 --format="Testando %H (pais: %P)"
                '''
            }
        }

        stage('Frontend') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm test'
                    sh 'npm run build'
                }
            }
        }

        stage('Backend: build') {
            steps {
                dir('backend') {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }

        stage('Backend: testes unitários') {
            steps {
                dir('backend') {
                    sh 'npm run test:unit'
                }
            }
            post {
                always {
                    junit testResults: 'backend/reports/unit/junit.xml', allowEmptyResults: true
                }
            }
        }

        stage('Backend: testes de integração') {
            steps {
                dir('backend') {
                    sh 'npm run test:integration'
                }
            }
            post {
                always {
                    junit testResults: 'backend/reports/integration.xml', allowEmptyResults: true
                }
            }
        }
    }
}
