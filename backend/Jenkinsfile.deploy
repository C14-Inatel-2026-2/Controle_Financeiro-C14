pipeline {
    agent {
        label 'node24'
    }

    options {
        // O checkout será explícito para permitir limpar o workspace antes.
        skipDefaultCheckout(true)

        // Duas execuções ao mesmo tempo disputariam o mesmo contêiner de verificação.
        disableConcurrentBuilds()

        // A primeira construção baixa as imagens base e instala as dependências dos dois projetos.
        timeout(time: 30, unit: 'MINUTES')

        // Limita o histórico e os artefatos armazenados neste Jenkins local.
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        // Repositório público no Docker Hub.
        IMAGEM = 'bunnyzzw/controle-financeiro-c14'

        // Nome do contêiner e do volume temporários da verificação, únicos por execução.
        VERIFICACAO = "c14-verificacao-${env.BUILD_NUMBER}"
    }

    stages {
        stage('Obter código') {
            steps {
                deleteDir()

                // Usa o repositório e a revisão configurados no job: o
                // GIT_COMMIT_SHA da pipeline completa ou a ponta de BRANCH.
                checkout scm

                // Falha se o HEAD não for a revisão pedida ao job.
                load 'infra/jenkins/confirmar-revisao.groovy'

                script {
                    // A tag é o SHA completo do commit aprovado pelos builds e testes.
                    env.COMMIT = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    env.REFERENCIA = "${env.IMAGEM}:${env.COMMIT}"
                    currentBuild.description = env.REFERENCIA
                }
            }
        }

        stage('Conferir acesso ao Docker') {
            steps {
                // Falha cedo se o agente não alcança o Docker Desktop (veja docs/ci-cd/deploy.md).
                sh 'docker version'
            }
        }

        stage('Construir imagem') {
            steps {
                sh '''
                    set -eu
                    docker build --pull \
                        --label "org.opencontainers.image.revision=$COMMIT" \
                        --label "org.opencontainers.image.source=https://github.com/C14-Inatel-2026-2/Controle_Financeiro-C14" \
                        --tag "$REFERENCIA" .
                '''
            }
        }

        stage('Verificar imagem') {
            steps {
                sh '''
                    set -eu

                    # A imagem final leva só o necessário e não executa como root.
                    conteudo=$(docker run --rm --entrypoint ls "$REFERENCIA" -A /app | xargs)
                    if [ "$conteudo" != "dist node_modules package.json public" ]; then
                        echo "Conteúdo inesperado em /app: $conteudo"
                        exit 1
                    fi
                    if [ "$(docker run --rm --entrypoint id "$REFERENCIA" -u)" = "0" ]; then
                        echo "A imagem não deve executar como root."
                        exit 1
                    fi

                    docker volume create "$VERIFICACAO" > /dev/null

                    # 1ª execução: teste por HTTP, com o Secure desligado explicitamente.
                    docker run -d --name "$VERIFICACAO" -v "$VERIFICACAO:/data" -e COOKIE_SECURE=false "$REFERENCIA" > /dev/null
                    docker exec -i -e ETAPA=antes "$VERIFICACAO" node - < infra/jenkins/verificar-imagem.js

                    # 2ª execução: contêiner novo, mesmo volume e configuração padrão (cookie Secure).
                    docker rm -f "$VERIFICACAO" > /dev/null
                    docker run -d --name "$VERIFICACAO" -v "$VERIFICACAO:/data" "$REFERENCIA" > /dev/null
                    docker exec -i -e ETAPA=depois "$VERIFICACAO" node - < infra/jenkins/verificar-imagem.js
                '''
            }
        }

        stage('Publicar no Docker Hub') {
            // Só publica quando chamado pela pipeline completa, depois dos builds e testes do mesmo SHA.
            // Uma execução manual deste job constrói e verifica a imagem, mas não a publica.
            when {
                expression { currentBuild.getBuildCauses('hudson.model.Cause$UpstreamCause') ? true : false }
            }
            steps {
                script {
                    // latest acompanha só a main, e só se o SHA ainda for a ponta dela.
                    def pontaDaMain = sh(script: 'git ls-remote origin refs/heads/main | cut -f1', returnStdout: true).trim()
                    env.PUBLICAR_LATEST = (params.BRANCH == 'main' && env.COMMIT == pontaDaMain) ? 'true' : 'false'
                }

                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKERHUB_USUARIO',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''
                        set -eu

                        # O login fica num diretório próprio desta execução, apagado ao sair, inclusive em falha.
                        DOCKER_CONFIG=$(mktemp -d)
                        export DOCKER_CONFIG
                        trap 'rm -rf "$DOCKER_CONFIG"' EXIT
                        printf '%s' "$DOCKERHUB_TOKEN" | docker login --username "$DOCKERHUB_USUARIO" --password-stdin

                        docker push "$REFERENCIA"

                        if [ "$PUBLICAR_LATEST" = "true" ]; then
                            docker tag "$REFERENCIA" "$IMAGEM:latest"
                            docker push "$IMAGEM:latest"
                        else
                            echo "latest não foi atualizada: o commit não é a ponta atual da main."
                        fi

                        # Consulta o registro, e não a cópia local, para registrar o digest publicado.
                        DIGEST=$(docker buildx imagetools inspect "$REFERENCIA" --format '{{.Manifest.Digest}}')
                        printf 'referencia=%s\\ndigest=%s@%s\\nlatest=%s\\n' "$REFERENCIA" "$IMAGEM" "$DIGEST" "$PUBLICAR_LATEST" > imagem-publicada.txt
                        cat imagem-publicada.txt
                    '''
                }

                script {
                    currentBuild.description = readFile('imagem-publicada.txt').trim().replace('\n', ' | ')
                }
            }
        }
    }

    post {
        always {
            // Guarda os logs da aplicação para diagnóstico e apaga só os recursos desta verificação.
            sh '''
                docker logs "$VERIFICACAO" > verificacao.log 2>&1 || true
                docker rm -f "$VERIFICACAO" > /dev/null 2>&1 || true
                docker volume rm "$VERIFICACAO" > /dev/null 2>&1 || true
            '''

            archiveArtifacts(
                artifacts: 'verificacao.log, imagem-publicada.txt',
                allowEmptyArchive: true
            )
        }
    }
}
